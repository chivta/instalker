# Consumed by create-secrets.sh. Copy to .env.secrets and fill in.
# .env.secrets is gitignored and must never be committed.

GHCR_USERNAME=your_github_username
GHCR_PAT=ghp_xxx
GHCR_EMAIL=you@example.com

USERNAME=your_instagram_username
PASSWORD=your_instagram_password
IG_SESSIONID=

BOT_TOKEN=123456:ABC-DEF
CHAT_ID=123456789

# Empty means: watch every account USERNAME follows.
TARGETS=
