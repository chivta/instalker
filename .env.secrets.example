# Consumed by create-secrets.sh, which only creates the GHCR pull secret.
# Copy to .env.secrets and fill in. .env.secrets is gitignored.
#
# The bot's own credentials are NOT here — they live in k8s/secrets.yaml
# (gitignored) and are committed SOPS-encrypted as k8s/secrets.enc.yaml.

GHCR_USERNAME=your_github_username
GHCR_PAT=ghp_xxx
GHCR_EMAIL=you@example.com
