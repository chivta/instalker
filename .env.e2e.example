# Credentials for the end-to-end tests. Copy to .env.e2e and fill in.
# .env.e2e and the session file are gitignored and must never reach CI.

# From https://my.telegram.org/apps — required for a user (not bot) client.
TG_API_ID=1234567
TG_API_HASH=00000000000000000000000000000000

# The spare account. Only used by `go run ./test/e2e/login`, which is
# interactive and writes the session file below.
TG_PHONE=+10000000000
TG_SESSION_FILE=.e2e-session.json

# Printed by the login command; the spare account's id, which is also the chat
# the bot under test is configured to answer in.
TG_USER_ID=

# A SEPARATE bot from production. Two clients polling one token fight over
# updates, and whichever wins swallows them.
STAGING_BOT_TOKEN=123456:ABC-DEF
