# Instagram account used to watch the targets.
USERNAME=your_instagram_username
PASSWORD=your_instagram_password

# Session cookie of an already logged-in browser session, used to BOOTSTRAP the
# database the first time only. After that the stored session wins and this is
# ignored, so rotate with the /session command rather than by editing this.
# Copy the value of the `sessionid` cookie from instagram.com.
IG_SESSIONID=

# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF

# Overrides the Bot API endpoint. Empty means the real one; tests point it at a
# fake server, and it also serves a self-hosted Bot API or the test environment.
TELEGRAM_API_URL=

# Chat that receives the notifications. The chat must have messaged the bot at
# least once (send /start) or Telegram rejects delivery with "chat not found".
CHAT_ID=123456789

# Accounts to watch, comma separated. Only used when the schedule
# (internal/schedule/schedule.toml) names none; empty falls back to whoever the
# logged-in account follows.
TARGETS=

# Loads a schedule from disk instead of the one compiled into the binary.
SCHEDULE_PATH=

# Local state: which media has already been forwarded.
DB_PATH=data/instalker.db

# Health and metrics endpoints.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info
