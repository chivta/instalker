# Instagram account used to watch the targets.
USERNAME=your_instagram_username
PASSWORD=your_instagram_password

# Session cookie of an already logged-in browser session.
# Preferred over password login: Instagram challenges fresh password logins from
# datacenter IPs. Copy the value of the `sessionid` cookie from instagram.com.
IG_SESSIONID=

# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF

# Chat that receives the notifications. The chat must have messaged the bot at
# least once (send /start) or Telegram rejects delivery with "chat not found".
CHAT_ID=123456789

# Accounts to watch, comma separated. Leave empty to watch every account the
# logged-in user follows.
TARGETS=

# How often to poll. Stories expire after 24h, so keep this well under that.
POLL_INTERVAL=5m

# Local state: which media has already been forwarded.
DB_PATH=data/instalker.db

# Health and metrics endpoints.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info
